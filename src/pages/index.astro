---

import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import { SITE } from "@consts"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,4)
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <!-- Background elements -->
  <!-- Light Mode: Modern Gradient + Particles -->
  <div class='absolute inset-0 block dark:hidden'>
    <div class='fixed inset-0 bg-gradient-to-br from-blue-50/30 via-white to-purple-50/20'></div>
    <div class='fixed inset-0 bg-[radial-gradient(ellipse_at_top,rgba(59,130,246,0.08)_0%,transparent_40%)]'></div>
    <div class='fixed inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(168,85,247,0.06)_0%,transparent_40%)]'></div>
    <div id='particles' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Modern Gradient Background -->
  <div class='absolute inset-0 hidden dark:block'>
    <div class='fixed inset-0 bg-gradient-to-br from-zinc-900 via-slate-900/95 to-zinc-900/90'></div>
    <div class='fixed inset-0 bg-[radial-gradient(ellipse_at_top,rgba(59,130,246,0.15)_0%,transparent_50%)]'></div>
    <div class='fixed inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(168,85,247,0.12)_0%,transparent_50%)]'></div>
  </div>

  <!-- Dark Theme: Twinkling Stars / Metors -->
  <div id="galaxy" class="fixed inset-0">
    <div class="hidden dark:block">
      <TwinklingStars/>
      <MeteorShower/>
    </div>
  </div>

  <script is:inline src="/js/bg.js"></script>
  <script is:inline src="/js/scroll-animations.js" defer></script>
  
  <!-- Hero Section -->
  <section class="relative min-h-[70vh] flex items-center justify-center pt-32 pb-20">
    <div class="mx-auto max-w-4xl text-center px-6">
      <div class="space-y-6 animate-fade-in">
        <div class="text-6xl sm:text-8xl" style="font-family: 'Inter', sans-serif; font-weight: 600;">
          👋
        </div>
        <h1 class="text-6xl sm:text-8xl font-bold text-black dark:text-white" style="font-family: 'Inter', sans-serif;">
          Hi there!
        </h1>
        <h2 class="text-2xl sm:text-3xl font-medium text-black/80 dark:text-white/80 mt-2">
          Welcome to my online presence
        </h2>
      </div>
      
      <div class="mt-6 max-w-3xl mx-auto animate-slide-up">
        <p class="text-lg sm:text-xl text-black/70 dark:text-white/70 leading-relaxed font-normal">
          I write here occasionally
        </p>
      </div>
      
      <div class="flex flex-wrap justify-center gap-4 mt-12 animate-slide-up-delayed">
        <a href="/blog" class="btn-supabase btn-supabase-primary group">
          <span>Blog</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9l7 7v9a2 2 0 0 1-2 2z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 3v6h6"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6M9 16h6"/>
          </svg>
        </a>
        <a href="/about" class="btn-supabase btn-supabase-secondary group">
          <span>Or Something?</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 12c2.761 0 5-2.239 5-5s-2.239-5-5-5-5 2.239-5 5 2.239 5 5 5z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 20c0-4.418 3.582-8 8-8s8 3.582 8 8"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <div class="relative bg-gradient-to-b from-transparent via-white/30 dark:via-zinc-900/30 to-transparent">
    <div class="mx-auto max-w-6xl px-6 py-20 space-y-24">

      <!-- About Section -->
      <section class="animate-section">
        <div class="text-center max-w-3xl mx-auto space-y-8">
          <h2 class="text-4xl md:text-5xl font-black text-black dark:text-white">
            About Me
          </h2>
          <div class="space-y-6 text-lg text-black/70 dark:text-white/70 leading-relaxed">
            <p>I'm just a regular person — someone who enjoys simple things done well. I enjoy building things. I thrive on challenges that let me learn by doing and solving problems.</p>
          </div>
        </div>
</section>

      <!-- Recent Blog Posts Section -->
      <section class="space-y-12 animate-section">
        <div class="text-center space-y-6">
          <h2 class="text-4xl md:text-5xl font-black text-black dark:text-white">
            Latest Blog Posts
          </h2>
          <p class="text-lg text-black/60 dark:text-white/60">
            Recent thoughts on anything that I wish I could put into words.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-4 gap-6 items-stretch max-w-4xl mx-auto">
          {posts.map((post) => (
            <div class="transform-none hover:transform-none">
              <ArrowCard entry={post} pill={true} />
            </div>
          ))}
        </div>
        
        <div class="text-center">
          <a href="/blog" class="btn-supabase btn-supabase-primary group">
            <span>All Posts</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </section>

      <!-- Timeless Quote Section -->
      <section class="space-y-12 animate-section">
        <div class="max-w-4xl mx-auto text-center space-y-8">
          <div class="relative inline-block">
            <div class="relative p-12 rounded-3xl bg-white/5 dark:bg-black/5 border border-black/10 dark:border-white/10">
              <svg class="w-12 h-12 mx-auto mb-6 text-black/20 dark:text-white/20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
              <blockquote class="text-2xl md:text-3xl font-bold italic text-black dark:text-white leading-relaxed mb-6">
                "Prolonged derangement of the senses in order to obtain the unknown."
              </blockquote>
              <p>
                — Jim Morrison
              </p>
            </div>
          </div>
          </div>
          
          <div class="space-y-4 text-center">
            <h3 class="text-xl font-semibold text-black dark:text-white">-.-.-</h3>
          
            <p class="text-black/60 dark:text-white/60 max-w-2xl mx-auto text-center">
              You made it this far. Hope it's worth it.
            </p>
            <h3 class="text-xl font-semibold text-black dark:text-white">-.-.-</h3>
          </div>
        </div>
      </section>

    </div>
  </div>
  

</PageLayout>
