---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import { WORK, SOCIALS } from "@consts"

const collection = await getCollection("work")
collection.sort((a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime())
const work = await Promise.all(collection.map(async (item) => { const { Content } = await item.render(); return { ...item, Content } }))

function formatWorkDate(input: Date | string) {
  if (typeof input === "string") return input
  const month = input.toLocaleDateString("en-US", { month: "short" })
  const year = new Date(input).getFullYear()
  return `${month} ${year}`
}
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <div class="fixed inset-0 gradient-bg pointer-events-none"></div>
  
  <div class="fixed inset-0 pointer-events-none overflow-hidden">
    <div class="glow-orb glow-orb-blue w-[26rem] h-[26rem] -top-40 -left-40 animate-pulse-slow"></div>
    <div class="glow-orb glow-orb-blue w-96 h-96 bottom-0 -right-48 animate-pulse-slow" style="animation-delay: 4s"></div>
  </div>

  <div class="relative z-10 pt-36 pb-5">
    <Container size="md">

      <!-- Top decorative row -->
      <div class="flex items-center justify-between text-[0.6875rem] uppercase tracking-[0.2em] text-slate-400 mb-12">
        <div class="flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-slate-400"></span>
          <span>vol. 01 — a small dossier</span>
        </div>
        <div class="hidden sm:block text-slate-400">
          chapter 03
        </div>
      </div>

      <!-- Decorative oversized punctuation -->
      <div aria-hidden="true" class="absolute top-20 right-0 text-[10rem] sm:text-[14rem] font-display text-blue-500/10 leading-none select-none pointer-events-none font-bold">§</div>

      <!-- Hero / Intro -->
      <section class="mb-20">
        <div class="grid grid-cols-12 gap-6 items-end">
          <div class="col-span-12 md:col-span-8">
            <div class="text-[0.625rem] uppercase tracking-[0.3em] text-blue-600 font-medium mb-4">
              § 03 — the dossier
            </div>
            <h1 class="font-display font-bold leading-[0.9] tracking-tighter text-slate-900">
              <span class="block text-[clamp(3rem,9vw,6.5rem)] text-transparent bg-clip-text bg-gradient-to-br from-slate-900 via-blue-700 to-blue-500" style="font-variation-settings: 'wdth' 75;">
                {WORK.TITLE}
              </span>
            </h1>
          </div>
          <div class="col-span-12 md:col-span-4 md:pl-8 md:border-l border-slate-200">
            <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
              <span class="text-slate-900 font-medium">Places I've worked,</span> things I've learned, and the people who taught me along the way.
            </p>
          </div>
        </div>

        <!-- Pull-quote card -->
        <div class="mt-16 relative">
          <div aria-hidden="true" class="absolute -top-6 -left-4 text-[6rem] font-display text-blue-500/15 leading-none select-none pointer-events-none font-bold">"</div>
          <blockquote class="card p-8 md:p-10 relative">
            <p class="text-2xl md:text-3xl font-display italic text-slate-800 leading-[1.3] tracking-tight text-center">
              I read, I write, I swim, but <span class="text-blue-600">I don't smoke.</span>
            </p>
          </blockquote>
        </div>
      </section>

      <!-- Section divider -->
      <div class="flex items-center gap-4 text-[0.625rem] uppercase tracking-[0.25em] text-slate-400 mb-10">
        <span>work history</span>
        <span class="flex-1 h-px bg-slate-200"></span>
        <span class="font-mono text-slate-300">{work.length} entries</span>
      </div>

      <!-- Work timeline -->
      <section class="space-y-6 md:space-y-8">
        {work.map((entry, index) => (
          <div class="work-card animate card p-7 md:p-9 overflow-hidden group" style={{"animation-delay": `${index * 0.1}s`} as Record<string, string>}>
            <div class="relative z-10">
              <div class="flex items-start justify-between gap-4 mb-5 flex-wrap">
                <div class="inline-flex items-center px-3 py-1.5 border border-slate-200 rounded-md text-slate-600 text-xs tracking-wider uppercase font-mono">
                  <svg class="size-3.5 mr-1.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                  {formatWorkDate(entry.data.dateStart)} <span class="mx-1 text-slate-300">→</span> {formatWorkDate(entry.data.dateEnd)}
                </div>
                <div class="text-[0.625rem] uppercase tracking-[0.25em] text-slate-400 font-mono">
                  no. {String(work.length - index).padStart(2, "0")}
                </div>
              </div>

              <div class="grid grid-cols-12 gap-4 items-baseline">
                <h3 class="col-span-12 md:col-span-7 text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 leading-tight">
                  {entry.data.company}
                </h3>
                <div class="col-span-12 md:col-span-5 text-base md:text-lg font-medium text-blue-600 flex items-center md:justify-end">
                  <svg class="size-4 mr-2 text-blue-500/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                  <span class="font-display italic">{entry.data.role}</span>
                </div>
              </div>

              <div class="mt-6 h-px bg-slate-200"></div>

              <div class="work-entry prose prose-slate max-w-none mt-6"><entry.Content /></div>
            </div>
          </div>
        ))}
      </section>

      <!-- Footer / sign-off -->
      <div class="mt-24 text-center space-y-6">
        <div class="flex items-center justify-center gap-2 text-slate-300 font-mono text-xs tracking-[0.4em]">
          <span>·</span><span>·</span><span>·</span>
        </div>
        <p class="text-slate-500 text-sm italic font-display">still in progress. always.</p>
        <div class="flex items-center justify-center gap-2 text-slate-300 font-mono text-xs tracking-[0.4em]">
          <span>·</span><span>·</span><span>·</span>
        </div>

        <!-- Socials -->
        <div class="pt-6">
          <div class="text-[0.625rem] uppercase tracking-[0.25em] text-slate-400 mb-3">elsewhere</div>
          <div class="flex flex-wrap items-center justify-center gap-3 text-sm">
            {SOCIALS.map(social => (
              <a href={social.HREF} target="_blank" rel="noopener" class="btn">
                <span>{social.NAME}</span>
                <span class="text-slate-400">→</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </div>
</PageLayout>

<style>
  .work-entry :global(p) { margin-bottom: 1.25rem; color: rgb(71 85 105); line-height: 1.7; }
  .work-entry :global(ul) { margin-top: 1rem; margin-bottom: 1.25rem; }
  .work-entry :global(li) { margin-bottom: 0.5rem; padding-left: 0.25rem; color: rgb(71 85 105); }
  .work-entry :global(li::marker) { color: rgb(59 130 246); }
  .work-entry :global(h3) { font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; color: rgb(15 23 42); font-family: var(--font-display); }
  .work-entry :global(strong) { font-weight: 700; color: rgb(15 23 42); }
  @keyframes slideUpFade { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
  .work-card { animation: slideUpFade 0.8s ease-out forwards; }
  @media (max-width: 768px) {
    .work-card { padding: 1.5rem; }
    .work-card .text-2xl { font-size: 1.5rem; }
    .work-card .text-xl { font-size: 1.25rem; }
  }
</style>
