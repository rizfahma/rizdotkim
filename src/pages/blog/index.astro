---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Blog from "@components/Blog"
import { BLOG } from "@consts"

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <div class="fixed inset-0 gradient-bg pointer-events-none"></div>
  
  <div class="fixed inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-32 -right-32 w-[36rem] h-[36rem] bg-blue-500/[0.03] rounded-full blur-[100px]"></div>
    <div class="absolute top-1/2 -left-40 w-[32rem] h-[32rem] bg-blue-400/[0.02] rounded-full blur-[80px]"></div>
  </div>

  <TopLayout>
    <div class="relative z-10">

      <!-- Top decorative row -->
      <div class="flex items-center justify-between text-[0.6875rem] uppercase tracking-[0.2em] text-slate-400 mb-10">
        <div class="flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-slate-400"></span>
          <span>vol. 01 — the archive</span>
        </div>
        <div class="hidden sm:block text-slate-400">
          index of {posts.length} entries
        </div>
      </div>

      <!-- Decorative oversized punctuation -->
      <div aria-hidden="true" class="absolute -top-8 left-0 text-[10rem] sm:text-[12rem] font-display text-blue-500/10 leading-none select-none pointer-events-none font-bold">§</div>

      <!-- Hero header -->
      <div class="grid grid-cols-12 gap-6 items-end">
        <div class="col-span-12 md:col-span-8">
          <div class="text-[0.625rem] uppercase tracking-[0.3em] text-blue-600 font-medium mb-4">
            § 02 — writing
          </div>
          <h1 class="font-display font-bold leading-[0.9] tracking-tighter text-slate-900">
            <span class="block text-[clamp(3.5rem,10vw,7rem)] text-transparent bg-clip-text bg-gradient-to-br from-slate-900 via-blue-700 to-blue-500" style="font-variation-settings: 'wdth' 75;">
              {BLOG.TITLE}
            </span>
          </h1>
        </div>
        <div class="col-span-12 md:col-span-4 md:pl-8 md:border-l border-slate-200">
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
            {BLOG.DESCRIPTION} <span class="text-slate-400 italic">A growing collection of things I've thought about long enough to write down.</span>
          </p>
        </div>
      </div>

      <!-- Divider with metadata -->
      <div class="mt-16 flex items-center gap-4 text-[0.625rem] uppercase tracking-[0.25em] text-slate-400">
        <span>all entries</span>
        <span class="flex-1 h-px bg-slate-200"></span>
        <span class="font-mono">↓</span>
      </div>
    </div>
  </TopLayout>

  <BottomLayout>
    <div class="relative z-10">
      <Blog client:load data={posts} />
    </div>
  </BottomLayout>
</PageLayout>
