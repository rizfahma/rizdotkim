---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import ChatWidget from "@components/ChatWidget.tsx"
const { title, description } = Astro.props
import { SITE } from "@consts"
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} | ${SITE.TITLE}`} description={description} />
  </head>
  <body class="min-h-screen bg-white text-slate-900">
    <Header />
    
    <main class="flex-1 pt-16">
      <slot />
    </main>

    <Footer />
    <ChatWidget client:only="solid-js" />

    <!-- Back to Top Button -->
    <button id="back-to-top" type="button" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="fixed bottom-6 right-6 z-50 p-3 bg-white backdrop-blur-sm border border-slate-200 rounded-lg text-slate-500 hover:text-blue-600 hover:border-blue-300 transition-all duration-300 opacity-0 translate-y-10 cursor-pointer" style="display:none" aria-label="Scroll to top">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
    </button>

    <script is:inline>
      const backToTopBtn = document.getElementById('back-to-top');
      function updateBackToTop() {
        if (window.scrollY > 400) {
          backToTopBtn.style.display = 'flex';
          backToTopBtn.style.alignItems = 'center';
          backToTopBtn.style.justifyContent = 'center';
          backToTopBtn?.classList.remove('opacity-0', 'translate-y-10');
          backToTopBtn?.classList.add('opacity-100', 'translate-y-0');
        } else {
          backToTopBtn?.classList.remove('opacity-100', 'translate-y-0');
          backToTopBtn?.classList.add('opacity-0', 'translate-y-10');
          setTimeout(() => { if (!backToTopBtn?.classList.contains('opacity-100')) backToTopBtn.style.display = 'none'; }, 300);
        }
      }
      if (window.scrollY > 400) { backToTopBtn.style.display = 'flex'; backToTopBtn.style.alignItems = 'center'; backToTopBtn.style.justifyContent = 'center'; backToTopBtn?.classList.remove('opacity-0', 'translate-y-10'); backToTopBtn?.classList.add('opacity-100', 'translate-y-0'); }
      window.addEventListener('scroll', updateBackToTop, { passive: true });
    </script>
  </body>
</html>
