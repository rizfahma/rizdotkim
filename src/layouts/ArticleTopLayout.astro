---
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "@lib/utils"

type Props = { entry: CollectionEntry<"projects"> | CollectionEntry<"blog"> }
const { entry } = Astro.props
const { collection, data, body } = entry
const { title, summary, date } = data
const demoUrl = collection === "projects" ? data.demoUrl : null
const repoUrl = collection === "projects" ? data.repoUrl : null
---

<div class="space-y-6">
  <div class="flex flex-wrap items-center gap-4 text-xs uppercase tracking-[0.12em] text-slate-500">
    <div class="flex items-center gap-1.5">
      <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      {formatDate(date)}
    </div>
    <div class="flex items-center gap-1.5">
      <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      {readingTime(body)}
    </div>
  </div>

  <h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-slate-900 leading-[1.1] font-display">{title}</h1>

  <p class="text-lg text-slate-600 leading-relaxed">{summary}</p>

  {collection === "blog" && data.tags && data.tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {data.tags.map((tag: string) => (
        <a href={`/blog?tag=${tag}`} class="text-xs uppercase tracking-wider px-2.5 py-1 rounded-md bg-slate-100 text-slate-600 border border-slate-200 hover:border-blue-300 hover:text-blue-600 transition-colors duration-200">{tag}</a>
      ))}
    </div>
  )}

  {(demoUrl || repoUrl) && (
    <div class="flex flex-wrap gap-3 pt-4">
      {demoUrl && <a href={demoUrl} target="_blank" class="btn"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>Live Demo</a>}
      {repoUrl && <a href={repoUrl} target="_blank" class="btn"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>Source Code</a>}
    </div>
  )}
</div>
