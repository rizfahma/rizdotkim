---
import Container from "@components/Container.astro"
import { LINKS, SOCIALS, SITE } from "@consts"
import { cn } from "@lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)
---

<footer class="border-t border-slate-200/50 mt-auto relative z-10">
  <Container size="md">
    <div class="py-12 space-y-10">
      <!-- Top row: brand + nav -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-5">
          <a href="/" class="inline-flex items-center gap-3 group">
            <svg class="size-7" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
              <circle cx="500" cy="500" r="497.5" fill="currentColor"/>
              <text x="500" y="750" font-family="Inter, sans-serif" font-size="600" font-weight="bold" text-anchor="middle" fill="white">RF</text>
            </svg>
            <span class="font-bold tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors duration-200">{SITE.TITLE}</span>
          </a>
          <p class="mt-4 text-sm text-slate-500 leading-relaxed max-w-sm">
            A small corner of the internet where I write about code, ideas, and everything else that crosses my mind.
          </p>
          <div class="mt-4 flex items-center gap-3 text-sm text-slate-500">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span>All systems normal</span>
          </div>
        </div>

        <div class="md:col-span-3">
          <div class="text-[0.625rem] uppercase tracking-[0.3em] text-slate-400 mb-4 font-mono">§ pages</div>
          <ul class="space-y-2.5 text-sm">
            {LINKS.map((LINK) => (
              <li>
                <a
                  href={LINK.HREF}
                  class={cn(
                    "font-bold tracking-wide transition-colors duration-200",
                    (pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF)
                      ? "text-blue-600"
                      : "text-slate-600 hover:text-slate-900"
                  )}
                  aria-current={(pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF) ? "page" : undefined}
                >
                  {LINK.TEXT}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="md:col-span-4">
          <div class="text-[0.625rem] uppercase tracking-[0.3em] text-slate-400 mb-4 font-mono">§ elsewhere</div>
          <ul class="space-y-2.5 text-sm">
            {SOCIALS.map((SOCIAL) => (
              <li>
                <a href={SOCIAL.HREF} target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-blue-600 font-bold tracking-wide transition-colors duration-200 inline-flex items-center gap-1.5">
                  <span>{SOCIAL.NAME}</span>
                  <span class="text-slate-400 text-xs">↗</span>
                </a>
              </li>
            ))}
            <li>
              <a href="/rss.xml" target="_blank" class="text-slate-600 hover:text-blue-600 font-bold tracking-wide transition-colors duration-200 inline-flex items-center gap-1.5">
                <span>RSS feed</span>
                <span class="text-slate-400 text-xs">↗</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Decorative divider -->
      <div class="flex items-center gap-3 text-slate-300">
        <span class="h-px flex-1 bg-slate-200"></span>
        <span class="text-[0.625rem] uppercase tracking-[0.4em] font-mono">· · ·</span>
        <span class="h-px flex-1 bg-slate-200"></span>
      </div>

      <!-- Bottom row: legal + copyright -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <div class="flex items-center gap-4">
          <a href="/legal/terms" class="hover:text-blue-600 transition-colors duration-200">Terms</a>
          <span class="text-slate-300">·</span>
          <a href="/legal/privacy" class="hover:text-blue-600 transition-colors duration-200">Privacy</a>
        </div>
        <div class="font-mono text-slate-400">
          &copy; {new Date().getFullYear()} {SITE.TITLE}
        </div>
        <div class="font-mono text-slate-400">
          built with <span class="text-slate-500">astro</span>
        </div>
      </div>
    </div>
  </Container>
</footer>
