---
import { SITE, LINKS } from "@consts"
import { cn } from "@lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)
---

<div id="drawer" class="fixed inset-0 h-0 z-40 overflow-hidden flex flex-col items-center justify-center md:hidden transition-[height] duration-300 ease-in-out" style="background: rgb(var(--background));">
  <nav class="flex flex-col items-center space-y-1">
    {LINKS.map((LINK) => (
      <a href={LINK.HREF} class={cn("flex items-center justify-center px-4 py-2 text-lg font-medium uppercase tracking-wider opacity-50 hover:opacity-100 transition-opacity", (pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF) && "opacity-100 pointer-events-none")}>
        {LINK.TEXT}
      </a>
    ))}
  </nav>
  <div class="flex gap-1 mt-6">
    <a href="/search" aria-label={`Search on ${SITE.TITLE}`} class={cn("icon-btn opacity-70 hover:opacity-100", (pathname === "/search" || "/" + subpath?.[0] === "search") && "opacity-100 pointer-events-none")}>
      <svg class="size-full"><use href="/ui.svg#search"></use></svg>
    </a>
    <a href="/rss.xml" target="_blank" aria-label={`RSS feed for ${SITE.TITLE}`} class="icon-btn opacity-70 hover:opacity-100">
      <svg class="size-full"><use href="/ui.svg#rss"></use></svg>
    </a>
  </div>
</div>

<style>
  #drawer.open { @apply h-full; }
</style>
