<!-- Non-blocking CSS with preload trick -->
<link rel="preload" href="/_astro/index.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="/_astro/index.css"></noscript>

<!-- Martian Mono from Google Fonts (non-blocking) -->
