---
import { SITE, LINKS, SOCIALS } from "@consts"
import { cn } from "@lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)
---

<header id="header" class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-200/50">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <svg class="size-8" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <circle cx="500" cy="500" r="497.5" fill="currentColor"/>
        <text x="500" y="750" font-family="Inter, sans-serif" font-size="600" font-weight="bold" text-anchor="middle" fill="white">RF</text>
      </svg>
      <span class="font-semibold tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors duration-200">{SITE.TITLE}</span>
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {LINKS.map((LINK) => (
        <a
          href={LINK.HREF}
          data-nav-link
          class={cn(
            "nav-pill",
            (pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF) && "active"
          )}
          aria-current={(pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF) ? "page" : undefined}
        >
          {LINK.TEXT}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/search" aria-label="Search" class={cn("icon-btn", (pathname === "/search" || "/" + subpath?.[0] === "/search") && "text-blue-600 border-blue-300")}>
        <svg class="size-4"><use href="/ui.svg#search"></use></svg>
      </a>

      <button id="mobile-menu-button" class="md:hidden icon-btn" onclick="toggleMobileMenu()" aria-label="Toggle menu">
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-slate-200/50 bg-white/95 backdrop-blur-md">
    <nav class="px-6 py-4 space-y-1" aria-label="Mobile">
      {LINKS.map((LINK) => (
        <a
          href={LINK.HREF}
          data-nav-link
          class={cn(
            "block px-4 py-3 rounded-lg text-sm font-bold tracking-wide transition-colors duration-200",
            (pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF)
              ? "text-blue-600 bg-blue-50"
              : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
          )}
          aria-current={(pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF) ? "page" : undefined}
        >
          {LINK.TEXT}
        </a>
      ))}
      <div class="pt-4 mt-4 border-t border-slate-200/50 flex items-center gap-2">
        <a href="/rss.xml" target="_blank" aria-label="RSS" class="icon-btn opacity-60 hover:opacity-100">
          <svg class="size-4"><use href="/ui.svg#rss"></use></svg>
        </a>
        {SOCIALS.map((SOCIAL) => (
          <a href={SOCIAL.HREF} target="_blank" rel="noopener noreferrer" aria-label={SOCIAL.NAME} class="icon-btn opacity-60 hover:opacity-100">
            <svg class="size-4" style="fill: currentColor"><use href={`/social.svg#${SOCIAL.ICON}`}/></svg>
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  function toggleMobileMenu() {
    const menu = document.getElementById("mobile-menu")
    menu?.classList.toggle("hidden")
  }

  (function trackVisitedNavLinks() {
    try {
      var STORAGE_KEY = "riz:visited-nav";
      var visited = {};
      try { visited = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"); } catch (e) { visited = {}; }

      var applyVisited = function () {
        var navLinks = document.querySelectorAll("a[data-nav-link]");
        navLinks.forEach(function (link) {
          var href = link.getAttribute("href");
          if (href && visited[href]) link.classList.add("visited");
        });
        var footerLinks = document.querySelectorAll("footer a[href^='/']");
        footerLinks.forEach(function (link) {
          var href = link.getAttribute("href");
          if (href && visited[href]) {
            link.classList.add("text-slate-900");
            link.classList.remove("text-slate-600");
          }
        });
      };

      var allLinks = document.querySelectorAll("a[data-nav-link], footer a[href^='/']");
      allLinks.forEach(function (link) {
        link.addEventListener("click", function () {
          var href = link.getAttribute("href");
          if (!href) return;
          visited[href] = true;
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(visited)); } catch (e) {}
        });
      });

      applyVisited();
    } catch (e) {}
  })();
</script>
